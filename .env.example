# Secrets live only in psst. Run scripts/init-secrets.ps1 then scripts/start.ps1 -Build.
# Required names: OKNO_DB_ADMIN_PASSWORD, OKNO_DB_MIGRATOR_PASSWORD,
# OKNO_DB_APP_PASSWORD, OKNO_SESSION_SECRET, OKNO_ENCRYPTION_KEY
APP_ORIGIN=http://localhost:18430
APP_TIMEZONE=Europe/Warsaw
COOKIE_SECURE=false
DATA_MODE=synthetic
ROUTING_MODE=manual
LLM_MODE=off
SOLVER_TOTAL_BUDGET_SECONDS=20
SOLVER_MAX_CONCURRENT=2
PLAN_RETENTION_DAYS=30
BACKUP_RETENTION_DAYS=7
# Optional importer only: GROQ_API_KEY, FIRECRAWL_API_KEY from psst.
